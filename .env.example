# Postgres (ParadeDB: pg_search + pgvector)
AF_PG_DSN=postgresql://agentforge:agentforge@localhost:5433/agentforge

# Anthropic — required from milestone M3 onward (M1/M2 need no key)
ANTHROPIC_API_KEY=

# Langfuse Cloud (free tier) — optional until M6
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local model cache
AF_MODEL_DIR=./models
